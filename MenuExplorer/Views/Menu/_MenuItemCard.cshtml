@model MenuExplorer.Models.MenuItem
@{

}
<div class="menu-card" data-menu-search="@Model.Name @Model.Description">
    <div class="menu-card-top">
        <span class="category-badge">
            @Model.Category
        </span>

        @if (Model.IsVegetarian)
        {
            <span class="vegetarian-badge">
                Vegetarian
            </span>
        }
    </div>

    <div class="menu-card-body">

        <h2>@Model.Name</h2>

        <p class="menu-card-description">
            @Model.Description
        </p>

        <div class="menu-card-rating">
            <star-rating value="@Model.Rating"></star-rating>
        </div>

    </div>

    <div class="menu-card-footer">

        <span class="price">
            R @Model.Price.ToString("0.00")
        </span>

        <a asp-controller="Menu"
           asp-action="itemdetails"
           asp-route-id="@Model.Id"
           class="details-link">
            View details
        </a>

    </div>

    
</div>
