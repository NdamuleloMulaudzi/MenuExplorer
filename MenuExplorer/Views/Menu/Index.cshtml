@model List<MenuExplorer.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
}

<section class="page-header">

    <div>
        <h1>Our Menu</h1>

        <p>
            Good food. Good prices. No royal nonsense.
        </p>
    </div>
</section>



<div class="menu-container">

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h2>No menu items found</h2>
            <p>There are no menu items available for this selection.</p>
        </div>
    }
    else
    {
        <div class="menu-grid">
            @foreach (var item in Model)
            {
                <partial name="_MenuItemCard" model="item" />
            }
        </div>
    }
</div>