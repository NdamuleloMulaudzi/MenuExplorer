@model List<MenuExplorer.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
}

<section class="page-header">

    <div>
        <span class="eyebrow">THE KINGDOM'S KITCHEN</span>

        <h1>Our Menu</h1>

        <p>
            Good food. Good prices. No royal nonsense.
        </p>
    </div>
</section>


<div class="menu-grid">
    @foreach(var menuItem in Model)
    {
        <div class="menu">
            <partial name="_MenuItemCard" model="menuItem" />
        </div>
    }
</div>