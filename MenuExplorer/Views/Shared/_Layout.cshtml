<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KingDOM</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">

        <div class="container">

            <a asp-controller="Menu"
               asp-action="Index"
               class="brand">
                <span class="brand-crown">&#9819</span>
                <span>KingDOM</span>
            </a>

            <nav class="main-nav">

                <a asp-controller="Menu"
                   asp-action="Index">
                    Menu
                </a>

                <a asp-controller="Menu"
                   asp-action="FeaturedItems">
                    Featured Items
                </a>

            </nav>

        </div>

    </header>

    <partial name="_CategoryFilter" />

    <main class="container">
        @RenderBody()
    </main>


    <footer class="footer">
     @*    <div class="container">
            <p>Good food. Fit for royalty.</p>
        </div> *@
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
